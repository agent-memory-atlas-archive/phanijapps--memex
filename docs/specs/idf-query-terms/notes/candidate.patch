diff --git a/tests/unit/test_idf_query_terms.py b/tests/unit/test_idf_query_terms.py
new file mode 100644
index 0000000..e5b30c5
--- /dev/null
+++ b/tests/unit/test_idf_query_terms.py
@@ -0,0 +1,183 @@
+"""Index-derived query term filtering: fts5vocab document frequency drives token drops."""
+
+import sqlite3
+from pathlib import Path
+
+from memex.domain.models import WikiNode
+from memex.infrastructure.search.bm25_retriever import (
+    MAX_TERM_DOCUMENT_RATIO,
+    BM25Retriever,
+    production_ranker_metadata,
+)
+from memex.infrastructure.search.index_manager import SCHEMA_VERSION, IndexManager
+from memex.infrastructure.store.wiki_store import WikiStore
+
+
+def _node(title: str, body: str, *, slug: str) -> WikiNode:
+    return WikiNode(type="entity", title=title, body=body, id=slug, slug=slug)
+
+
+def _index_nodes(data_dir: Path, nodes: list[WikiNode]) -> IndexManager:
+    store = WikiStore(data_dir)
+    index = IndexManager(data_dir / "mem.db")
+    for node in nodes:
+        index.update_record(store.write(node))
+    return index
+
+
+def _table_names(index: IndexManager) -> set[str]:
+    rows = index.connection.execute(
+        "SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name"
+    ).fetchall()
+    return {str(row["name"]) for row in rows}
+
+
+def _strict_match(statements: list[str]) -> str:
+    matches = [statement for statement in statements if "wiki_fts MATCH" in statement]
+    assert matches, statements
+    return matches[0]
+
+
+def _traced_retriever(data_dir: Path) -> tuple[BM25Retriever, list[str]]:
+    retriever = BM25Retriever(data_dir / "mem.db")
+    statements: list[str] = []
+    retriever._conn.set_trace_callback(statements.append)
+    return retriever, statements
+
+
+def test_schema_version_is_seven_and_vocab_table_exists_on_fresh_index(data_dir: Path) -> None:
+    index = IndexManager(data_dir / "mem.db")
+
+    assert SCHEMA_VERSION == "7"
+    assert "wiki_vocab" in _table_names(index)
+    assert index.get_meta("schema_version") == SCHEMA_VERSION
+    index.close()
+
+
+def test_rebuild_path_recreates_vocab_table(data_dir: Path) -> None:
+    index = _index_nodes(data_dir, [_node("Alpha", "alpha body", slug="alpha")])
+
+    index.drop_for_rebuild()
+
+    assert "wiki_vocab" in _table_names(index)
+    assert index.connection.execute("SELECT COUNT(*) AS n FROM wiki_vocab").fetchone()["n"] == 0
+    index.update_record(WikiStore(data_dir).write(_node("Beta", "beta body", slug="beta")))
+    terms = {str(row["term"]) for row in index.connection.execute("SELECT term FROM wiki_vocab")}
+    assert {"beta", "bodi"} <= terms
+    index.close()
+
+
+def test_pre_vocab_store_gains_vocab_table_on_open(data_dir: Path) -> None:
+    index = _index_nodes(data_dir, [_node("Alpha", "alpha body", slug="alpha")])
+    index.connection.execute("DROP TABLE wiki_vocab")
+    index.connection.commit()
+    index.close()
+
+    reopened = IndexManager(data_dir / "mem.db")
+
+    assert "wiki_vocab" in _table_names(reopened)
+    assert reopened.needs_rebuild() is False
+    reopened.close()
+
+
+def test_incompatible_legacy_index_is_replaced_with_vocab_table(data_dir: Path) -> None:
+    data_dir.mkdir()
+    connection = sqlite3.connect(data_dir / "mem.db")
+    connection.execute("CREATE TABLE wiki_index (id TEXT PRIMARY KEY, slug TEXT NOT NULL)")
+    connection.execute("CREATE VIRTUAL TABLE wiki_fts USING fts5(slug, title, body)")
+    connection.commit()
+    connection.close()
+
+    index = IndexManager(data_dir / "mem.db")
+
+    assert "wiki_vocab" in _table_names(index)
+    assert index.needs_rebuild() is True
+    index.close()
+
+
+def test_document_frequency_lookup_stems_query_tokens(data_dir: Path) -> None:
+    index = _index_nodes(
+        data_dir,
+        [
+            _node("One", "runs handled databases", slug="one"),
+            _node("Two", "running handles", slug="two"),
+            _node("Three", "unrelated words", slug="three"),
+        ],
+    )
+    retriever = BM25Retriever(data_dir / "mem.db")
+
+    frequencies = retriever._document_frequencies(["run", "handle", "database", "absent"])
+
+    assert frequencies == [2, 2, 1, 0]
+    retriever.close()
+    index.close()
+
+
+def test_tokens_above_document_ratio_are_dropped(data_dir: Path) -> None:
+    pages = [_node(f"Page {n}", f"common filler{n}", slug=f"page-{n}") for n in range(10)]
+    pages.append(_node("Target", "common filler0 rare", slug="target"))
+    index = _index_nodes(data_dir, pages)
+    retriever, statements = _traced_retriever(data_dir)
+
+    result = retriever.retrieve("common rare", top_k=5)
+
+    assert MAX_TERM_DOCUMENT_RATIO < 1.0
+    assert [hit.slug for hit in result.hits] == ["target"]
+    assert "'rare'" in _strict_match(statements)
+    retriever.close()
+    index.close()
+
+
+def test_tokens_absent_from_the_index_are_dropped(data_dir: Path) -> None:
+    index = _index_nodes(
+        data_dir,
+        [
+            _node("Target", "kafka consumer", slug="target"),
+            _node("Other", "postgres pool", slug="other"),
+        ],
+    )
+    retriever, statements = _traced_retriever(data_dir)
+
+    result = retriever.retrieve("kafka eviction", top_k=5)
+
+    assert [hit.slug for hit in result.hits] == ["target"]
+    assert "'kafka'" in _strict_match(statements)
+    assert sum("wiki_fts MATCH" in statement for statement in statements) == 1
+    retriever.close()
+    index.close()
+
+
+def test_last_remaining_tokens_are_never_dropped(data_dir: Path) -> None:
+    index = _index_nodes(
+        data_dir,
+        [_node(f"Page {n}", "shared everywhere", slug=f"page-{n}") for n in range(3)],
+    )
+    retriever, statements = _traced_retriever(data_dir)
+
+    result = retriever.retrieve("shared everywhere", top_k=5)
+
+    assert [hit.slug for hit in result.hits] == ["page-0", "page-1", "page-2"]
+    assert "'shared AND everywhere'" in _strict_match(statements)
+    retriever.close()
+    index.close()
+
+
+def test_query_of_only_absent_tokens_keeps_its_first_token(data_dir: Path) -> None:
+    index = _index_nodes(data_dir, [_node("Page", "indexed words", slug="page")])
+    retriever, statements = _traced_retriever(data_dir)
+
+    result = retriever.retrieve("missing gone", top_k=5)
+
+    assert result.hits == []
+    assert "'missing'" in _strict_match(statements)
+    retriever.close()
+    index.close()
+
+
+def test_ranker_metadata_describes_document_frequency_filtering() -> None:
+    metadata = production_ranker_metadata()
+
+    assert "removed_scaffolding" not in metadata
+    assert metadata["term_filter"] == "fts5vocab-document-frequency"
+    assert metadata["max_term_document_ratio"] == MAX_TERM_DOCUMENT_RATIO
+    assert "explicit_function_words" not in metadata
