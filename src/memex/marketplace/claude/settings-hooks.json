{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "memex hook session-start" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "memex hook prompt" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "memex hook transcript --harness claude" }
        ]
      }
    ]
  }
}
